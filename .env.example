DATABASE_URL="postgresql://postgres:password@localhost:5432/wortgarten"
WEB_PORT=5173
API_PORT=3026

# Long random string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
# The API's own base URL — Better Auth mounts at {BETTER_AUTH_URL}/auth and
# uses this to build the Google OAuth redirect URI (register it as
# {BETTER_AUTH_URL}/auth/callback/google in Google Cloud Console).
BETTER_AUTH_URL=http://localhost:3026
# Comma-separated list of web app origins (CORS + Better Auth trustedOrigins)
WEB_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GROQ_API_KEY=
# All optional — sensible defaults live in packages/ai; only set to override.
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_DAILY_LIMIT=100
# AI_MAX_RETRIES=2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct-q4
# OLLAMA_KEEP_ALIVE=5m

# Overnight story batch (apps/worker `story:batch`) — all optional, sensible defaults in
# packages/ai/src/story and apps/worker/src/jobs/story-batch.ts; only set to override.
# STORY_ELIGIBLE_ACTIVE_DAYS=7
# STORY_BATCH_MAX=200
# STORY_BATCH_DEADLINE=05:30
# Minimum % of story tokens that must resolve to known vocab, else the draft is skipped.
# STORY_MIN_COVERAGE_PCT=70

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wortgarten
R2_PUBLIC_BASE_URL=

# Story cover images (packages/images) — billed per image, off by default. Flip to "true" only
# after R2_PUBLIC_BASE_URL above and the chosen provider's credentials below are set, and current
# image pricing has been checked.
STORY_IMAGES_ENABLED=false
# Which provider generates covers — "gemini" (default) or "cloudflare". One active provider at a
# time, no automatic fallback between them; switch by editing this value.
# IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Cloudflare Workers AI — only needed when IMAGE_PROVIDER=cloudflare. Reuses R2_ACCOUNT_ID above
# (same Cloudflare account as R2); needs its own Bearer API token (Workers AI scope), not the R2
# HMAC keys.
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
# STORY_IMAGES_MAX_PER_DAY=

# apps/web dev server — overrides fetch base when API isn't proxied at /api (e.g. custom setup).
# VITE_API_URL=
# STORY_CHAT_ENABLED=
# Story Chat reply variety (choice/tiles/rusty-nudge on top of type) — on unless set to "false".
# CHAT_REPLY_VARIETY=
# Story Chat memory (per-conversation MemoryNote, written nightly by `chat:memory-batch`) — on
# unless set to "false". Off means no note is read/written; the recent-message window still
# applies (no unbounded prompt growth either way).
# CHAT_MEMORY_ENABLED=
# CHAT_MEMORY_BATCH_MAX=500