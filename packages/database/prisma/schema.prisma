
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  ARTICLE
  NUMERAL
  PARTICLE
  OTHER
}

enum Gender {
  MASCULINE
  FEMININE
  NEUTER
}

enum Provenance {
  SEED
  AI
  USER
}

enum WordLevel {
  NEW
  RECOGNIZE
  RECALL
  PRODUCE
  MASTERED
}

enum TaskType {
  PICK_MEANING
  TYPE_WORD
  BUILD_SENTENCE
  WRITE_SENTENCE
}

enum AttemptResult {
  CORRECT
  CORRECT_WITH_TYPO
  MISSING_UMLAUT
  MISSING_ARTICLE
  WRONG_GENDER
  WRONG_MEANING
  WRONG_FORM
  EMPTY
}

enum DrillSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum FsrsRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum TaskStatus {
  READY
  USED
  FAILED_CHECK
}

enum StoryStatus {
  READY
  READ
  FAILED_CHECK
}

enum AiSource {
  GROQ
  OLLAMA
}

enum ExampleSource {
  WIKTIONARY
  TATOEBA
  AI
  USER
}

// ─── Better Auth ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  tagline       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  timezone      String    @default("UTC")
  sessions      Session[]
  accounts      Account[]

  userWords     UserWord[]
  tasks         Task[]
  stories       Story[]
  drillSessions DrillSession[]
  streak        UserStreak?

  @@map("user")
}

model UserStreak {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  current         Int       @default(0)
  longest         Int       @default(0)
  freezesBanked   Int       @default(0)
  lastLearningDay DateTime?
  lastComputedAt  DateTime?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Dictionary (shared, seeded later) ─────────────────────────────────────

model Lexeme {
  id           String       @id // deterministic content hash (see packages/seed) — never @default(cuid())
  sourceKey    String       @unique // the raw identity key the id was hashed from; debugging/re-mapping
  language     String       @default("de")
  lemma        String
  partOfSpeech PartOfSpeech

  // nouns
  gender Gender?
  plural String?

  // verbs
  separablePrefix String?
  auxiliary       String?
  government      String?

  // kaikki's homograph discriminator. Informational only — NOT part of Lexeme
  // identity (see lexemeCoreKey in packages/seed/src/map.ts). Null when this
  // lexeme merged raw entries from more than one etymology.
  etymologyNumber Int?

  frequencyRank Int?

  provenance Provenance @default(SEED)
  isVerified Boolean    @default(false)

  senses       Sense[]
  forms        WordForm[]
  exampleWords ExampleWord[]

  @@index([language, lemma, partOfSpeech])
  @@index([language, frequencyRank])
}

model Sense {
  id          String  @id // deterministic content hash (see packages/seed) — never @default(cuid())
  sourceKey   String  @unique // `${lexemeId}|${normalizedGloss}` the id was hashed from
  lexemeId    String
  lexeme      Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  translation String
  definition  String?
  example     String?
  cefrLevel   String?

  // A sentence that illustrates THIS meaning specifically — set from a sense-exact
  // Wiktionary example. Distinct from ExampleWord, which indexes every sentence a
  // word appears in regardless of which sense it's drilling.
  primaryExampleId String?
  primaryExample   Example? @relation("SensePrimaryExample", fields: [primaryExampleId], references: [id])

  userWords    UserWord[]
  exampleWords ExampleWord[]

  @@index([lexemeId])
}

// A German sentence, its English translation, and provenance/flags. Deduped via
// `normalized` since the same sentence arrives from Wiktionary and Tatoeba alike;
// `id` is a deterministic content hash of `normalized` (see packages/seed/src/map.ts
// contentId) so re-seeding never mints a new id for a sentence already stored.
model Example {
  id           String        @id
  text         String
  translation  String
  normalized   String        @unique
  tokenCount   Int
  source       ExampleSource
  sourceRef    String? // e.g. "tatoeba:370121/245800" — required for CC-BY attribution
  isWellFormed Boolean       @default(false) // per SENTENCE: length, punctuation, vocabulary

  words            ExampleWord[]
  primaryForSenses Sense[]       @relation("SensePrimaryExample")

  @@index([isWellFormed, tokenCount])
}

// The reverse index: which lexemes appear in which sentences, and whether each
// pairing is safe to drill (see Part 5 of the sentence-corpus spec — a sentence
// can be well-formed overall yet unusable for one ambiguous word in it, e.g.
// "Ich gehe zur Bank." is usable for "gehen" but not for "Bank").
model ExampleWord {
  exampleId        String
  lexemeId         String
  senseId          String? // null = could not disambiguate which sense this occurrence is
  position         Int // token index in the sentence (the finite verb's own token, for a separable-verb row)
  surface          String // the inflected form as it actually appears
  isUsableForTiles Boolean @default(false) // per PAIR: well-formed AND sense resolved

  // Set only for a reassembled separable verb (e.g. "Ich rufe dich an." → anrufen): the token
  // index and surface text of the separated prefix, so the session player's tip generator can
  // highlight both halves ("anrufen splits: Ich rufe dich an."). Null for every ordinary row.
  prefixPosition Int?
  prefixSurface  String?

  example Example @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  lexeme  Lexeme  @relation(fields: [lexemeId], references: [id])
  sense   Sense?  @relation(fields: [senseId], references: [id])

  @@id([exampleId, lexemeId, position])
  @@index([lexemeId, isUsableForTiles]) // THE query: "tileable sentences containing this word"
  @@index([senseId, isUsableForTiles])
}

model WordForm {
  id         String @id @default(cuid())
  lexemeId   String
  lexeme     Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  surface    String
  normalized String
  features   Json?

  @@index([normalized])
  @@index([lexemeId])
}

// ─── Word bank (personal) ───────────────────────────────────────────────────

model UserWord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  senseId String
  sense   Sense  @relation(fields: [senseId], references: [id])

  level WordLevel @default(NEW)

  // FSRS state
  stability      Float     @default(0)
  difficulty     Float     @default(0)
  dueAt          DateTime  @default(now())
  reps           Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime?

  // personal
  customTranslation String?
  sourceSentence    String?
  sourceType        String?
  note              String?

  // Display-only aggregate cache rebuilt from non-retry Attempt rows when needed.
  // Shape: { PICK_MEANING?: { total, correct }, TYPE_WORD?: { total, correct }, BUILD_SENTENCE?: { total, correct } }
  statsByMode Json @default("{}")

  addedAt DateTime @default(now())

  attempts Attempt[]
  tasks    Task[]

  @@unique([userId, senseId])
  @@index([userId, dueAt])
  @@index([userId, level])
}

model Attempt {
  id             String        @id @default(cuid())
  userWordId     String
  userWord       UserWord      @relation(fields: [userWordId], references: [id], onDelete: Cascade)
  taskType       TaskType
  result         AttemptResult
  responseTimeMs Int
  rating         FsrsRating
  answeredAt     DateTime      @default(now())

  drillSessionId String
  drillSession   DrillSession @relation(fields: [drillSessionId], references: [id], onDelete: Cascade)
  isRetry        Boolean      @default(false)
  // Idempotency key: the PlanItem this attempt answers. See DrillSession.plan.
  planItemId     String

  @@unique([drillSessionId, planItemId])
  @@index([userWordId, answeredAt])
  @@index([userWordId, taskType, answeredAt])
}

// A drill run: 10 tasks, chosen by FSRS due-ness, frozen at start. NOT to be
// confused with Better Auth's `Session` model above (login session) — that one
// stays untouched. This one is the quiz/review run.
model DrillSession {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       DrillSessionStatus @default(ACTIVE)
  // Ordered PlanItem[] INCLUDING solutions (server-only — sanitized before it
  // ever reaches the client). Retries are spliced into this array as the
  // session progresses; see SessionGradingService.
  plan         Json
  currentIndex Int                @default(0)
  isPractice   Boolean            @default(false)
  startedAt    DateTime           @default(now())
  completedAt  DateTime?
  attempts     Attempt[]

  @@index([userId, status])
}

// ─── Generated content (tables only — stay empty this task) ────────────────

model Task {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWordId String
  userWord   UserWord   @relation(fields: [userWordId], references: [id], onDelete: Cascade)
  type       TaskType
  payload    Json
  status     TaskStatus @default(READY)
  source     AiSource?
  createdAt  DateTime   @default(now())
  usedAt     DateTime?

  @@index([userId, status])
}

model Story {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  body          String
  tokenMap      Json
  newWordCount  Int
  minutes       Int
  status        StoryStatus @default(READY)
  source        AiSource?
  createdAt     DateTime    @default(now())
  readAt        DateTime?

  @@index([userId, status])
}

model AiQuota {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  source AiSource
  used   Int      @default(0)
  limit  Int

  @@unique([date, source])
}
