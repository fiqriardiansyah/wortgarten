
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  ARTICLE
  NUMERAL
  PARTICLE
  OTHER
}

enum Gender {
  MASCULINE
  FEMININE
  NEUTER
}

enum Provenance {
  SEED
  AI
  USER
}

enum WordLevel {
  NEW
  RECOGNIZE
  RECALL
  PRODUCE
  MASTERED
}

enum TaskType {
  PICK_MEANING
  TYPE_WORD
  BUILD_SENTENCE
  WRITE_SENTENCE
}

enum AttemptResult {
  CORRECT
  CORRECT_WITH_TYPO
  MISSING_UMLAUT
  MISSING_ARTICLE
  WRONG_GENDER
  WRONG_MEANING
  WRONG_FORM
  EMPTY
}

enum DrillSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum FsrsRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum TaskStatus {
  READY
  USED
  FAILED_CHECK
}

enum AiSource {
  GROQ
  OLLAMA
}

enum ExampleSource {
  WIKTIONARY
  TATOEBA
  AI
  USER
}

// ─── Better Auth ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  tagline       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  timezone      String    @default("UTC")
  // Once true, HomeService/ProgressService stop silently overwriting `timezone` from the
  // browser-detected X-Timezone header — an explicit Profile-page choice must stick.
  timezoneSetManually Boolean @default(false)
  // Set once, at signup, by MeService.acceptTerms — never backfilled for accounts created before
  // this field existed (both stay null for those rows; do not retroactively mark them accepted).
  acceptedTermsAt      DateTime?
  acceptedTermsVersion String?
  sessions      Session[]
  accounts      Account[]

  userWords     UserWord[]
  tasks         Task[]
  stories       Story[]
  drillSessions DrillSession[]
  streak        UserStreak?
  worldUnlocks  UserWorldUnlock[]
  conversations Conversation[]
  deliveryEvents DeliveryEvent[]

  @@map("user")
}

model UserStreak {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  current         Int       @default(0)
  longest         Int       @default(0)
  freezesBanked   Int       @default(0)
  lastLearningDay DateTime?
  lastComputedAt  DateTime?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Dictionary (shared, seeded later) ─────────────────────────────────────

model Lexeme {
  id           String       @id // deterministic content hash (see packages/seed) — never @default(cuid())
  sourceKey    String       @unique // the raw identity key the id was hashed from; debugging/re-mapping
  language     String       @default("de")
  lemma        String
  partOfSpeech PartOfSpeech

  // nouns
  gender Gender?
  plural String?

  // verbs
  separablePrefix String?
  auxiliary       String?
  government      String?

  // kaikki's homograph discriminator. Informational only — NOT part of Lexeme
  // identity (see lexemeCoreKey in packages/seed/src/map.ts). Null when this
  // lexeme merged raw entries from more than one etymology.
  etymologyNumber Int?

  frequencyRank Int?

  provenance Provenance @default(SEED)
  isVerified Boolean    @default(false)

  senses       Sense[]
  forms        WordForm[]
  exampleWords ExampleWord[]
  worldWords   WorldWord[]

  @@index([language, lemma, partOfSpeech])
  @@index([language, frequencyRank])
}

model Sense {
  id          String  @id // deterministic content hash (see packages/seed) — never @default(cuid())
  sourceKey   String  @unique // `${lexemeId}|${normalizedGloss}` the id was hashed from
  lexemeId    String
  lexeme      Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  translation String
  definition  String?
  example     String?
  cefrLevel   String?

  // A sentence that illustrates THIS meaning specifically — set from a sense-exact
  // Wiktionary example. Distinct from ExampleWord, which indexes every sentence a
  // word appears in regardless of which sense it's drilling.
  primaryExampleId String?
  primaryExample   Example? @relation("SensePrimaryExample", fields: [primaryExampleId], references: [id])

  userWords    UserWord[]
  exampleWords ExampleWord[]

  @@index([lexemeId])
}

// A German sentence, its English translation, and provenance/flags. Deduped via
// `normalized` since the same sentence arrives from Wiktionary and Tatoeba alike;
// `id` is a deterministic content hash of `normalized` (see packages/seed/src/map.ts
// contentId) so re-seeding never mints a new id for a sentence already stored.
model Example {
  id           String        @id
  text         String
  translation  String
  normalized   String        @unique
  tokenCount   Int
  source       ExampleSource
  sourceRef    String? // e.g. "tatoeba:370121/245800" — required for CC-BY attribution
  isWellFormed Boolean       @default(false) // per SENTENCE: length, punctuation, vocabulary

  words            ExampleWord[]
  primaryForSenses Sense[]       @relation("SensePrimaryExample")

  @@index([isWellFormed, tokenCount])
}

// The reverse index: which lexemes appear in which sentences, and whether each
// pairing is safe to drill (see Part 5 of the sentence-corpus spec — a sentence
// can be well-formed overall yet unusable for one ambiguous word in it, e.g.
// "Ich gehe zur Bank." is usable for "gehen" but not for "Bank").
model ExampleWord {
  exampleId        String
  lexemeId         String
  senseId          String? // null = could not disambiguate which sense this occurrence is
  position         Int // token index in the sentence (the finite verb's own token, for a separable-verb row)
  surface          String // the inflected form as it actually appears
  isUsableForTiles Boolean @default(false) // per PAIR: well-formed AND sense resolved

  // Set only for a reassembled separable verb (e.g. "Ich rufe dich an." → anrufen): the token
  // index and surface text of the separated prefix, so the session player's tip generator can
  // highlight both halves ("anrufen splits: Ich rufe dich an."). Null for every ordinary row.
  prefixPosition Int?
  prefixSurface  String?

  example Example @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  lexeme  Lexeme  @relation(fields: [lexemeId], references: [id])
  sense   Sense?  @relation(fields: [senseId], references: [id])

  @@id([exampleId, lexemeId, position])
  @@index([lexemeId, isUsableForTiles]) // THE query: "tileable sentences containing this word"
  @@index([senseId, isUsableForTiles])
}

model WordForm {
  id         String @id @default(cuid())
  lexemeId   String
  lexeme     Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  surface    String
  normalized String
  features   Json?

  @@index([normalized])
  @@index([lexemeId])
}

// ─── Word bank (personal) ───────────────────────────────────────────────────

model UserWord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  senseId String
  sense   Sense  @relation(fields: [senseId], references: [id])

  level WordLevel @default(NEW)

  // FSRS state
  stability      Float     @default(0)
  difficulty     Float     @default(0)
  dueAt          DateTime  @default(now())
  reps           Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime?

  // personal
  customTranslation String?
  sourceSentence    String?
  sourceType        String?
  note              String?

  // Display-only aggregate cache rebuilt from non-retry Attempt rows when needed.
  // Shape: { PICK_MEANING?: { total, correct }, TYPE_WORD?: { total, correct }, BUILD_SENTENCE?: { total, correct } }
  statsByMode Json @default("{}")

  addedAt DateTime @default(now())

  attempts Attempt[]
  tasks    Task[]

  @@unique([userId, senseId])
  @@index([userId, dueAt])
  @@index([userId, level])
}

model Attempt {
  id             String        @id @default(cuid())
  userWordId     String
  userWord       UserWord      @relation(fields: [userWordId], references: [id], onDelete: Cascade)
  taskType       TaskType
  result         AttemptResult
  responseTimeMs Int
  rating         FsrsRating
  answeredAt     DateTime      @default(now())

  drillSessionId String
  drillSession   DrillSession @relation(fields: [drillSessionId], references: [id], onDelete: Cascade)
  isRetry        Boolean      @default(false)
  // Idempotency key: the PlanItem this attempt answers. See DrillSession.plan.
  planItemId     String

  @@unique([drillSessionId, planItemId])
  @@index([userWordId, answeredAt])
  @@index([userWordId, taskType, answeredAt])
}

// A drill run: 10 tasks, chosen by FSRS due-ness, frozen at start. NOT to be
// confused with Better Auth's `Session` model above (login session) — that one
// stays untouched. This one is the quiz/review run.
model DrillSession {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       DrillSessionStatus @default(ACTIVE)
  // Ordered PlanItem[] INCLUDING solutions (server-only — sanitized before it
  // ever reaches the client). Retries are spliced into this array as the
  // session progresses; see SessionGradingService.
  plan         Json
  currentIndex Int                @default(0)
  isPractice   Boolean            @default(false)
  startedAt    DateTime           @default(now())
  completedAt  DateTime?
  attempts     Attempt[]

  @@index([userId, status])
}

// ─── Generated content (tables only — stay empty this task) ────────────────

model Task {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWordId String
  userWord   UserWord   @relation(fields: [userWordId], references: [id], onDelete: Cascade)
  type       TaskType
  payload    Json
  status     TaskStatus @default(READY)
  source     AiSource?
  createdAt  DateTime   @default(now())
  usedAt     DateTime?

  @@index([userId, status])
}

// Every stored row is a shipped story — a draft that fails the shape checker (unparseable or
// empty; see packages/ai's story checker) is retried/fallback-provider'd and, if still failing,
// simply never persisted (no FAILED_CHECK row). `readAt` doubles as the "isRead" flag the frozen
// Story contract (packages/shared/src/story.ts) needs — no separate status enum.
model Story {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  blurb            String?
  // StoryParagraph[] (packages/shared/src/story.ts) verbatim — the worker's tokenMap precompute,
  // stored exactly in the frozen shape so the reader does zero runtime tokenization.
  paragraphs       Json
  translation      String?
  newWords         String[] // lexemeIds of the 1-2 intentionally-introduced words actually used
  glossary         Json // Record<lexemeId, StoryGlossaryEntry>, covers every word token
  coverageKnownPct Int
  estMinutes       Int
  source           AiSource?
  createdAt        DateTime  @default(now())
  readAt           DateTime?
  // R2 object key only, never a full URL (see packages/images) — null until the bonus cover-image
  // step succeeds, which always happens after the story above is already persisted and readable.
  coverImageKey    String?
  // Listen Mode (see packages/audio) — same bonus-layer discipline as coverImageKey: null until
  // the (optional, flag-gated) edge-tts step succeeds after this story is already persisted.
  // R2 object key only, never a full URL. `audioSync` is 'wordLevel' | 'sentenceLevel', validated
  // at the zod boundary (packages/shared's StoryAudioSyncSchema) rather than a Prisma enum, so the
  // DB value stays textually identical to the contract with no mapping layer.
  audioKey         String?
  audioSync        String?
  // SentenceTiming[] (packages/shared/src/story.ts), only populated when audioSync is
  // 'sentenceLevel' — per-sentence highlight spans for the reader's fallback karaoke mode.
  sentenceTimings  Json?
  // World.key, not a relation FK — worldKey is a stable code-defined slug (like WordLevel), so a
  // plain string is enough and avoids cascade-delete decisions on a table designed to grow later.
  // Null for stories generated before Story Worlds shipped.
  worldKey         String?
  // Story Chat (see below) — null until STORY_CHAT_ENABLED and the bonus persona-attach step
  // succeeds, same "already shipped, bonus layer" discipline as coverImageKey/audioKey above.
  character        Character?

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── Story Worlds (phase 1: hand-written JSON worlds, seeded) ──────────────
//
// A themed setting that rotates which vocabulary tonight's story leans on, unlocked as the user's
// own bank happens to cover it — never assigned, never gated. See packages/seed/data/worlds/*.json
// for the authored word lists and packages/ai/src/story/select-world.ts for the rotation logic.
model World {
  id            String            @id // deterministic content hash of `world:${key}` (see packages/seed)
  key           String            @unique
  name          String
  icon          String
  // The exact phrase spliced into the story prompt as one line: `Set this story ${hint}.` — a
  // hint, never a rule (see packages/ai/src/story/select-world.ts); it cannot cause a rejection.
  hint          String
  // 0 means always-unlocked (the free "everyday" world) — every user has it from day one.
  requiredCount Int
  // Full public URL (not an R2 key — worlds are hand-authored/seeded, not AI-generated like
  // Story.coverImageKey, so there's no derive-at-response-time step). Null renders as icon-only.
  image         String?
  words         WorldWord[]
  unlocks       UserWorldUnlock[]

  @@index([key])
}

// Compare by lexemeId, never by lemma string — see the model-level warning on Lexeme's callers in
// packages/seed and packages/ai; a string-keyed world would let homographs unlock the wrong sense.
model WorldWord {
  id       String @id @default(cuid())
  worldId  String
  world    World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  lexemeId String
  lexeme   Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([worldId, lexemeId])
  @@index([lexemeId])
}

// One row per (user, world), written once on first qualification and never deleted — an unlock is
// a permanent recorded event, not a cache of "haveCount >= requiredCount" (which can drop after a
// qualifying world is unlocked if the user later deletes words; the row must not follow it back
// down). Written only from SessionService.complete(), the sole place UserWord.level ever crosses
// into RECOGNIZE+.
model UserWorldUnlock {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldId    String
  world      World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, worldId])
  @@index([userId])
}

// A diagnostic review queue, never a write path into the dictionary: a surface form the story
// pipeline's resolver couldn't place at all (hallucination, invented name, typo, or an inflection
// LookupService doesn't handle) is upserted here after a story ships, purely for a human to read
// offline. Growth of Lexeme/Sense stays seeded and human-verified — this table is never joined
// into vocabulary selection or resolution, and nothing in the app auto-creates a Lexeme from it.
// A repeated real German word here (high `occurrences`) is a signal to fix the seed dictionary or
// LookupService, not to paper over it in the pipeline.
model UnresolvedStoryWord {
  id            String   @id @default(cuid())
  language      String
  surface       String
  occurrences   Int      @default(1)
  lastSeenAt    DateTime @default(now())
  sampleStoryId String?

  @@unique([language, surface])
}

model AiQuota {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  source AiSource
  used   Int      @default(0)
  limit  Int

  @@unique([date, source])
}

// ─── Story Chat (iteration 1) ───────────────────────────────────────────────
//
// A character from a story (or the pinned default host) the user can talk to. Persona is
// generated WITH the story in the same STORY AiJob response — no extra AI call. `storyId` is
// nullable: the pinned default host ("Tom") has no story and must exist before the user has read
// anything. `safetyLocked` rules sit above whatever persona/story content says and are assembled
// fresh into every system prompt at request time (see packages/ai/src/chat/persona-prompt.ts) —
// this column is a marker for future auditing, not itself an enforcement mechanism.
model Character {
  id           String        @id @default(cuid())
  storyId      String?       @unique
  story        Story?        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  name         String
  role         String
  personaLine  String
  levelCapJson Json
  archetype    String
  safetyLocked Boolean       @default(true)
  conversations Conversation[]
}

// One conversation per (user, character) they've met. The default host's conversation is
// lazy-created on first inbox fetch, same as a story character's conversation is lazy-created on
// first "💬 Talk to [name]" tap — see apps/api/src/chat/chat.service.ts.
model Conversation {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId    String
  character      Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  lastMessageAt  DateTime
  unreadCount    Int             @default(0)
  createdAt      DateTime        @default(now())
  messages       Message[]
  deliveryEvents DeliveryEvent[]
  memoryNote     MemoryNote?

  @@unique([userId, characterId])
  @@index([userId, lastMessageAt])
}

// One bubble. `tokensJson`/`glossary` power tap-a-word + Add on character bubbles only (mirrors
// Story.paragraphs/Story.glossary) — both stay null on `sender: "user"` rows, which render as
// plain text. `mode` records which ReplySlot renderer produced a user bubble (Seam 1); `source`
// records which TurnSource produced a character bubble (Seam 2) — "groq" | "scripted".
model Message {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String
  text           String
  translation    String?
  tokensJson     Json?
  glossary       Json?
  mode           String          @default("type")
  source         String?
  // The reply director's plan for the NEXT user turn (NextReplyPlan, see packages/shared/src/chat.ts)
  // — set on character rows only, null on "user" rows. Persisted (not recomputed on refetch) so a
  // choice/tiles turn's options survive a page reload instead of silently reshuffling.
  nextReplyPlanJson Json?
  createdAt      DateTime        @default(now())
  deliveryEvents DeliveryEvent[]

  @@index([conversationId, createdAt])
}

// ─── Story Chat (iteration 5: memory) ───────────────────────────────────────
//
// One running note per conversation, (re)written nightly by the worker (see
// packages/ai/src/chat/build-memory-note.ts) — never in the request path. `summary` replaces
// old bubbles for context purposes only; the real `Message` rows are never deleted or edited by
// this feature, so the user can still scroll their real history. `factsJson` is capped small
// (see CHAT_MEMORY_MAX_FACTS) and both the night summariser's prompt and the plain-code checker
// enforce the safety deny list (see memory-safety.ts) — nothing identifying is ever stored here.
model MemoryNote {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary        String       @default("")
  factsJson      Json         @default("[]") // MemoryFact[] — see packages/shared/src/chat.ts
  // The newest Message folded into `summary`/`factsJson` — the next nightly run only reads
  // messages created after this one. Null means the note has never been written (or was reset
  // by "Forget this"), so the next run folds in the conversation's entire history so far.
  lastMessageId  String?
  updatedAt      DateTime     @default(now())
}

// Delivery queue — in-app unread dots now; real push notification fields clip onto this same row
// later without a schema change.
model DeliveryEvent {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  deliveredInApp Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([userId, deliveredInApp])
}
